function formatEndDate(
    endDate: CachedUser["endDate"]
) {

    if (!endDate) {
        return "--";
    }

    return endDate
        .toDate()
        .toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
            }
        );

}

function getDaysRemaining(
    endDate: CachedUser["endDate"]
) {

    if (!endDate) {
        return "--";
    }

    const today = new Date();

    const expiry =
        endDate.toDate();

    const diff =
        expiry.getTime() -
        today.getTime();

    const days =
        Math.ceil(
            diff /
            (1000 * 60 * 60 * 24)
        );

    if (days < 0) {
        return "Expired";
    }

    return `${days} Days`;

}

