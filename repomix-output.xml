                        {/* Community Button */}

                        <button
                            onClick={(e) => {
                                e.stopPropagation();
                                setShowCommunity(!showCommunity);
                            }}
                            className="
                mt-6
                flex
                w-full
                items-center
                justify-between
                rounded-xl
                border
                border-gray-200
                bg-gray-50
                px-4
                py-3
                text-sm
                sm:text-base
                font-semibold
                text-gray-700
                hover:bg-gray-100
