------------------------------ */


/* Wave 1 */

@keyframes wave1 {
  0%, 100% {
    transform: translateX(-20px);
  }

  50% {
    transform: translateX(20px);
  }
}


.animate-wave1 {
  animation: wave1 5s ease-in-out infinite;
}


/* Wave 2 */

