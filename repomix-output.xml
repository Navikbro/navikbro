    subscription: UserSubscription
) {

    if (
        !subscription.trialEndDate
    ) {
        return false;
    }

    return (
        subscription.trialEndDate.toDate()
        <
        new Date()
    );

}

export function isSubscriptionExpired(
    subscription: UserSubscription
) {

    if (
        !subscription.endDate
    ) {
        return false;
    }

    return (
        subscription.endDate.toDate()
        <
        new Date()
    );

}
